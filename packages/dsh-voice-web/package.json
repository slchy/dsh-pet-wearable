{
  "name": "dsh-voice-web",
  "version": "0.0.1",
  "description": "Web compatibility for the dsh pet voice stack: WebSocket bridge plus browser capture and playback, reusing the voice stack from dsh-pet-wearable.",
  "type": "module",
  "license": "MIT",
  "author": "slchy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slchy/dsh-pet-wearable.git",
    "directory": "packages/dsh-voice-web"
  },
  "homepage": "https://github.com/slchy/dsh-pet-wearable#readme",
  "bugs": {
    "url": "https://github.com/slchy/dsh-pet-wearable/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "voice-agent",
    "websocket",
    "browser-audio",
    "realtime-audio"
  ],
  "exports": {
    ".": {
      "types": "./lib/driver.d.ts",
      "default": "./lib/driver.js"
    },
    "./browser": {
      "types": "./lib/browser-types/client.d.ts",
      "default": "./lib/browser.mjs"
    }
  },
  "main": "./lib/driver.js",
  "types": "./lib/driver.d.ts",
  "files": [
    "lib",
    "demo"
  ],
  "scripts": {
    "sync:voice": "node ../../scripts/sync-voice.mjs",
    "build:node": "tsc -p tsconfig.build.json",
    "build:browser": "esbuild src/browser/client.ts --bundle --format=esm --outfile=lib/browser.mjs",
    "build:browser-types": "tsc -p tsconfig.browser-types.json",
    "build": "npm run sync:voice && npm run build:node && npm run build:browser && npm run build:browser-types && npm run demo:build",
    "typecheck": "npm run sync:voice && tsc --noEmit && tsc --noEmit -p tsconfig.browser.json",
    "demo:build": "esbuild demo/main.ts --bundle --format=esm --outfile=demo/main.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "ws": "^8.23.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "onnxruntime-node": "^1.20.0",
    "typescript": "^5.7.0"
  }
}
