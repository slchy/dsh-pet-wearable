node_modules/
models/*.onnx
dist/

# 凭据与运行产物：真凭据一律不入库（模板见 .env.example）
.env
.env.*
!.env.example
tokens.txt
tmp/

# 证书与私钥只存在于部署机，路径由 MIAI_TLS_KEY / MIAI_TLS_CERT 注入。
# 这个仓平时一个证书文件都没有 —— 那条「没有文件所以进不了仓」的保证不算保证：
# 谁哪天把 cert.pem 放进来就会直接被提交。将来若要放示例证书，用 .example 后缀。
*.pem
*.key
*.crt
*.p12
*.jks
!*.pem.example
__pycache__/
bench/**/*.json
# 快车道的用例是测试数据，不是输出 —— 干净克隆要能跑 --offline
!bench/fast_lane/cases.json
# L3 回放基线也是测试数据：它是**判据**，不是产物。删了就等于回归闸门失效
!bench/replay/baseline/*.json
!bench/eval/manifest.json
!bench/eval/baseline/*.json
bench/eval/out/
bench/e2e/out/
bench/replay/out/
bench/e2e/mictap/out/

# 包② demo 的构建产物（npm run demo:build 生成）
packages/dsh-voice-web/demo/main.js

# 包② 里的语音栈副本：仓里只有一份源，这份由 scripts/sync-voice.mjs 生成，
# 不进 git（发包时由 prepack 重新同步，tarball 里是实体内容）。
packages/dsh-voice-web/src/voice/
packages/dsh-voice-web/lib/
packages/dsh-voice-web/LICENSE

# 本地跑服务时的临时日志
_*.log

# 运维记录：含真实主机/证书/设备等信息，不进公开仓。历史里已提交过，按要求不重写历史。
docs/OPS-RECORD.md
.probe-archive/
.realturn/

# 本地辅助工具的工作目录（不属于本项目）
.workbuddy/
