{
  "name": "dsh-pet-wearable",
  "version": "0.0.1",
  "description": "Pet for DeepSeek Harness (dsh) that lives on smart glasses — it speaks up on its own and shares your view. Early development; no stable API yet.",
  "type": "module",
  "license": "UNLICENSED",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "smart-glasses",
    "ar-glasses",
    "wearable",
    "pet",
    "voice",
    "proactive",
    "full-duplex"
  ],
  "exports": {
    ".": "./src/driver.ts",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "onnxruntime-node": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}

