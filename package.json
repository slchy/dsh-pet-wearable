{
  "name": "dsh-pet-wearable",
  "version": "0.0.1",
  "description": "Full-duplex voice agent for smart wearables, powered by cloud dsh. Speak anytime, interrupt anytime - it speaks up on its own too.",
  "type": "module",
  "license": "MIT",
  "author": "slchy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slchy/dsh-pet-wearable.git"
  },
  "homepage": "https://github.com/slchy/dsh-pet-wearable#readme",
  "bugs": {
    "url": "https://github.com/slchy/dsh-pet-wearable/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "voice-agent",
    "full-duplex",
    "barge-in",
    "speech-to-text",
    "text-to-speech",
    "realtime-audio",
    "smart-glasses",
    "ar-glasses",
    "wearable",
    "pet",
    "proactive"
  ],
  "exports": {
    ".": "./src/driver.ts",
    "./src/*": "./src/*"
  },
  "main": "./src/driver.ts",
  "types": "./src/driver.ts",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "start": "node src/main.ts",
    "install-profile": "node scripts/install-profile-patch.mjs",
    "pair": "node src/pair.ts",
    "sim": "node src/pet/sim/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:bench": "node --test bench/eval/*.test.ts bench/replay/*.test.ts",
    "test:web": "npm --prefix packages/dsh-voice-web test",
    "test:all": "npm test && npm run test:bench && npm run test:web",
    "mutate": "python scripts/mutation-check.py",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "onnxruntime-node": "^1.20.0",
    "undici": "^6.22.0",
    "ws": "^8.23.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.0"
  }
}
