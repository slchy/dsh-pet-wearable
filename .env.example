# 复制成 .env 后填值；不填就用 --stt canned --tts silent 跑通链路
# 阿里云实时识别（STT）
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
ALIYUN_APPKEY=
ALIYUN_NLS_REGION=cn-shanghai
# 业务专属热词表 ID（仅 POP API 建的那种）。控制台配的「项目热词」与 Appkey 绑定、
# 自动生效，留空即可；词清单见 docs/hotwords.txt
ALIYUN_VOCAB_ID=
# MiMo TTS
MIMO_API_KEY=
MIMO_TTS_VOICE=
# agent 可执行文件（Windows 指 npm shim；不填就用 PATH 里的 dsh）
# DSH_BIN=%APPDATA%\npm\dsh.cmd

# 设备鉴权（每行 token 或 token:deviceId）
# 用 `npm run pair -- new` 生成，别自己想字符串
# MIAI_TOKENS=./tokens.txt
# TLS（公网监听必须配齐；只给一个会启动即失败）
# MIAI_TLS_KEY=./tls/key.pem
# MIAI_TLS_CERT=./tls/cert.pem

# ---- 宠物环（主动开口）----
# 不设 = 关。**关着的时候 AppSession/PetBrain 根本不构造**，只剩对话环，
# 日志里会打一行「宠物环   关」。
# PET_PROACTIVE=1
# 心跳间隔。线上用 3 s（反应快、CPU 多十倍），代码默认 30 s
# PET_TICK_MS=30000
# 离场多久后重戴会打招呼（设计 5 min）
# 线上观察期用的是 3000，测完改回 300000
# PET_GREET_AWAY_MS=300000
# 安静多久后可以主动搭话（设计 20 min）
# 线上观察期用的是 180000，测完改回 1200000
# PET_CHATTER_IDLE_MS=1200000
# 说完之后开麦听回应多久
# PET_LISTEN_MS=8000
# 开麦到首帧上行的截止（小米实测 0.62 s）
# PET_MIC_OPEN_TIMEOUT_MS=1500

# ---- 延迟与 QoS（这些的默认值 = 线上值，一般不用设）----
# 判停每拍等待 / 最多几拍 / 总预算
# TURN_JUDGE_EXTEND_MS=200
# TURN_JUDGE_MAX_EXT=2
# TURN_JUDGE_MAX_UNSURE=1
# TURN_JUDGE_WAIT_BUDGET_MS=200
# 句尾像未完成的序列（数字/字母/「然后」）时放宽到这么久
# TURN_JUDGE_SEQUENCE_BUDGET_MS=1200
# 封段静音（仅 qwen-realtime；注意实际门槛是「一整个上行包」）
# VOICE_COMMIT_MS=20
# 首批发几个字（1 = 首字就发；服务端要等后续文本才开合成）
# COSYVOICE_FIRST_BATCH_CHARS=1
# 攒满 N 轮就整句交给 dsh。0 = 永不因计数转交
# FAST_LANE_KEEP_TURNS=0
# 认不认模型自己写的 [[DELEGATE]] 暗号
# FAST_LANE_DELEGATE=0
# 出站 HTTP 保活上限（必须短于服务端空闲超时）
# MIAI_HTTP_KEEPALIVE_MS=50000
# 上行增益：跟随当前眼镜实测值，换设备要重标
# MIAI_MIC_GAIN=4
