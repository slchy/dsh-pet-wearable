# 复制成 .env 后填值；不填就用 --stt canned --tts silent 跑通链路
# 阿里云实时识别（STT）
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=
ALIYUN_APPKEY=
ALIYUN_NLS_REGION=cn-shanghai
# MiMo TTS
MIMO_API_KEY=
MIMO_TTS_VOICE=
# agent 可执行文件（Windows 指 npm shim；不填就用 PATH 里的 dsh）
# DSH_BIN=%APPDATA%\npm\dsh.cmd

# ---- 长思考回执 ----
# dsh 跑工具时常常 5–8 s 一片安静，用户会以为"没听见"于是重复说。
# 超过这个时间还没开始出声就先说一句；设 0 关掉。
# MIAI_ACK_AFTER_MS=1200
# MIAI_ACK_TEXT=嗯，我看看。
# 设备鉴权（每行 token 或 token:deviceId）
# 用 `npm run pair -- new` 生成，别自己想字符串
# MIAI_TOKENS=./tokens.txt
# TLS（公网监听必须配齐；只给一个会启动即失败）
# MIAI_TLS_KEY=./tls/key.pem
# MIAI_TLS_CERT=./tls/cert.pem

# ---- 宠物环（主动开口）----
# 不设 = 关。**关着的时候 AppSession/PetBrain 根本不构造**，只剩对话环，
# 日志里会打一行「宠物环   关」。
# PET_PROACTIVE=1
# PET_TICK_MS=30000
# 离场多久后重戴会打招呼
# PET_GREET_AWAY_MS=300000
# 安静多久后可以主动搭话（设计默认 20 min）
# PET_CHATTER_IDLE_MS=1200000
# 说完之后开麦听回应多久
# PET_LISTEN_MS=8000
# 开麦到首帧上行的截止（小米实测 0.62 s）
# PET_MIC_OPEN_TIMEOUT_MS=1500
